    "walkthroughs": [
      {
        "id": "folium.gettingStarted",
        "title": "Get started with Folium Notes",
        "description": "Shared notes in the repo, private notes outside it, in one view.",
        "steps": [
          {
            "id": "open",
            "title": "Open the Notes view",
            "description": "Folium Notes adds a Notes view to the activity bar. Shared notes live in `.notes/` and are committed with the code; private notes live in your home folder.",
            "media": {
              "markdown": "images/screenshot-notes.png"
            }
          },
          {
            "id": "create",
            "title": "Create your first note",
            "description": "Create a shared note for the project, or a private note for yourself.\n[New Shared Note](command:folium.newSharedNote)",
            "media": {
              "markdown": "images/screenshot-notes.png"
            }
          },
          {
            "id": "templates",
            "title": "Start from a template",
            "description": "Eleven built-in templates, plus team templates in `.notes/.templates` and your own in `~/FoliumNotes/.templates`.\n[Browse Templates](command:folium.browseTemplates)",
            "media": {
              "markdown": "images/screenshot-templates.png"
            }
          },
          {
            "id": "tasks",
            "title": "Track tasks",
            "description": "Every `- [ ]` in a note shows up in the Tasks view, with due dates (`due:2026-11-22` or 📅).",
            "media": {
              "markdown": "images/screenshot-tasks.png"
            }
          },
          {
            "id": "terminal",
            "title": "Send a line to the terminal",
            "description": "Keep install, build and test commands in a Terminal Prompts note. Send the current line or a selection to the integrated terminal; Markdown markers and `$` prompts are stripped first.",
            "media": {
              "markdown": "images/screenshot-terminal.png"
            }
          },
          {
            "id": "ai",
            "title": "Work with AI safely",
            "description": "AI tools cannot read your notes. Send a prompt note to Copilot, Cline, Roo, Kilo or a custom target — private and sensitive notes are never sent.\n[Connect AI Tools](command:folium.connectAITools)",
            "media": {
              "markdown": "images/screenshot-ai-followup.png"
            }
          }
        ]
      }
    ]
  },
