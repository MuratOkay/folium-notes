      },
      {
        "command": "folium.showFilters",
        "title": "Folium: Show Active Filters"
      },
      {
        "command": "folium.groupBy",
        "title": "Folium: Group Notes By…",
        "icon": "$(list-unordered)"
      },
      {
        "command": "folium.sortBy",
        "title": "Folium: Sort Notes By…",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "folium.sortOrder",
        "title": "Folium: Toggle Sort Order",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "folium.renameTag",
        "title": "Folium: Rename Tag Everywhere"
      },
      {
        "command": "folium.removeTag",
