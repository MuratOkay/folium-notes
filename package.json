{
  "name": "folium-notes",
  "displayName": "Folium Notes",
  "description": "Project notes for developers: shared notes in the repo, private notes outside it, in one view.",
  "version": "0.1.0",
  "publisher": "folium",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Other",
    "Notebooks"
  ],
  "keywords": [
    "notes",
    "markdown",
    "tasks",
    "templates",
    "ai"
  ],
  "main": "./dist/extension.js",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/MuratOkay/folium-notes"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In untrusted workspaces Folium Notes runs in limited mode: project-level settings that could redirect network calls (issues, Joplin, prompt commands) and note encryption are ignored."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Folium Notes needs file system access for notes, trash and code links."
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "gen": "node scripts/gen-contributions.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node scripts/gen-contributions.mjs && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:win": "vitest run test/unit/windows.test.ts",
    "test:integration": "npm run build && node ./test/integration/run.mjs",
    "test:perf": "vitest run test/perf",
    "fixtures": "node scripts/gen-fixtures.mjs",
    "fixtures:check": "node scripts/gen-fixtures.mjs --check",
    "package": "npm run build && node scripts/package.mjs",
    "screenshots": "npm run package && node scripts/capture-screenshots.mjs",
    "vscode:prepublish": "npm run build",
    "verify": "npm run typecheck && npm run build && npm run test:unit && npm run fixtures:check && npm run docs:check",
    "docs": "node scripts/gen-docs.mjs",
    "docs:check": "node scripts/gen-docs.mjs --check",
    "package:stable": "npm run build && node scripts/package.mjs --stable"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "contributes": {
    "commands": [
      {
        "command": "folium.newNote",
        "title": "Folium: New Note",
        "icon": "$(add)"
      },
      {
        "command": "folium.newSharedNote",
        "title": "Folium: New Shared Note",
        "icon": "$(add)"
      },
      {
        "command": "folium.newPrivateNote",
        "title": "Folium: New Private Note"
      },
      {
        "command": "folium.newNoteWithTitle",
        "title": "Folium: New Note with Title"
      },
      {
        "command": "folium.newFromTemplate",
        "title": "Folium: New Note from Template"
      },
      {
        "command": "folium.browseTemplates",
        "title": "Folium: Browse Templates"
      },
      {
        "command": "folium.createTemplate",
        "title": "Folium: Create Template",
        "icon": "$(new-file)"
      },
      {
