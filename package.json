        "icon": "$(settings-gear)"
      },
      {
        "command": "folium.previewTemplate",
        "title": "Folium: Preview Template"
      },
      {
        "command": "folium.search",
        "title": "Folium: Search Notes",
        "icon": "$(search)"
      },
      {
        "command": "folium.searchWithQuery",
        "title": "Folium: Search Notes with Query"
      },
      {
        "command": "folium.statusMenu",
        "title": "Folium: Note Actions (status bar)"
      },
      {
        "command": "folium.openNote",
        "title": "Folium: Open Note"
      },
      {
        "command": "folium.setColor",
        "title": "Folium: Set Note Color",
        "icon": "$(symbol-color)"
      },
      {
        "command": "folium.togglePin",
        "title": "Folium: Toggle Pin",
        "icon": "$(pin)"
      },
      {
        "command": "folium.archive",
        "title": "Folium: Archive Note",
        "icon": "$(archive)"
      },
      {
        "command": "folium.unarchive",
        "title": "Folium: Unarchive Note"
      },
      {
        "command": "folium.renameNote",
