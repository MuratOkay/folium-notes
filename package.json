        "icon": "$(unlock)"
      },
      {
        "command": "folium.backupKey",
        "title": "Folium: Back Up Encryption Key"
      },
      {
        "command": "folium.restoreKey",
        "title": "Folium: Restore Encryption Key"
      },
      {
        "command": "folium.backupPrivate",
        "title": "Folium: Back Up Private Notes"
      },
      {
        "command": "folium.restorePrivate",
        "title": "Folium: Restore Private Notes"
      },
      {
        "command": "folium.configurePrivateRoot",
        "title": "Folium: Set Private Notes Folder"
      },
      {
        "command": "folium.openPrivateFolder",
        "title": "Folium: Open Private Notes Folder"
      },
      {
        "command": "folium.resetViewState",
        "title": "Folium: Reset View State"
      },
      {
        "command": "folium.importNotes",
        "title": "Folium: Import Notes",
        "icon": "$(cloud-download)"
      },
      {
        "command": "folium.exportNotes",
        "title": "Folium: Export Notes",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "folium.sendToJoplin",
        "title": "Folium: Send to Joplin"
      },
      {
        "command": "folium.createIssue",
        "title": "Folium: Create Issue from Note",
        "icon": "$(issues)"
      },
      {
        "command": "folium.branchNote",
        "title": "Folium: Branch Note",
        "icon": "$(git-branch)"
      },
      {
        "command": "folium.gettingStarted",
        "title": "Folium: Getting Started",
        "icon": "$(book)"
      },
      {
        "command": "folium.refresh",
        "title": "Folium: Refresh Notes",
        "icon": "$(refresh)"
