    "viewsContainers": {
      "activitybar": [
        {
          "id": "folium",
          "title": "Folium Notes",
          "icon": "images/folium.svg"
        }
      ]
    },
    "views": {
      "folium": [
        {
          "id": "folium.notes",
          "name": "Notes",
          "when": "workspaceFolderCount > 0",
          "icon": "images/view-notes.svg"
        },
        {
          "id": "folium.tags",
          "name": "Tags",
          "when": "workspaceFolderCount > 0",
          "icon": "images/view-tags.svg"
        },
        {
          "id": "folium.tasks",
          "name": "Tasks",
          "when": "workspaceFolderCount > 0",
          "icon": "images/view-tasks.svg"
        },
        {
          "id": "folium.related",
          "name": "Related",
          "when": "workspaceFolderCount > 0",
          "icon": "images/view-related.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "folium.notes",
        "contents": "No notes yet.\n[New Shared Note](command:folium.newSharedNote) · [New Private Note](command:folium.newPrivateNote) · [New from Template](command:folium.newFromTemplate)\nShared notes live in `.notes/` and are committed with the code. Private notes live in your home folder."
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "folium.newNote",
          "when": "view == folium.notes",
          "group": "navigation@1"
        },
        {
          "command": "folium.newFromTemplate",
          "when": "view == folium.notes",
          "group": "navigation@2"
        },
        {
          "command": "folium.search",
          "when": "view == folium.notes",
          "group": "navigation@3"
        },
        {
          "command": "folium.groupBy",
          "when": "view == folium.notes",
          "group": "navigation@4"
        },
        {
          "command": "folium.sortBy",
          "when": "view == folium.notes",
          "group": "navigation@5"
        },
        {
          "command": "folium.filterByTag",
          "when": "view == folium.notes",
          "group": "navigation@6"
        },
        {
          "command": "folium.clearFilters",
          "when": "view == folium.notes",
          "group": "navigation@7"
        },
        {
          "command": "folium.refresh",
          "when": "view == folium.notes",
          "group": "navigation@8"
        },
        {
          "command": "folium.filterByColor",
          "when": "view == folium.notes",
          "group": "1_filters@1"
        },
        {
          "command": "folium.filterByDate",
          "when": "view == folium.notes",
          "group": "1_filters@2"
        },
        {
          "command": "folium.filterByScope",
          "when": "view == folium.notes",
          "group": "1_filters@3"
        },
        {
          "command": "folium.filterByText",
          "when": "view == folium.notes",
          "group": "1_filters@4"
        },
        {
          "command": "folium.setTagFilterMode",
          "when": "view == folium.notes",
          "group": "1_filters@5"
        },
        {
          "command": "folium.emptyTrash",
          "when": "view == folium.notes",
          "group": "2_trash@1"
        },
        {
          "command": "folium.importNotes",
          "when": "view == folium.notes",
          "group": "3_io@1"
        },
        {
          "command": "folium.exportNotes",
          "when": "view == folium.notes",
          "group": "3_io@2"
        },
        {
          "command": "folium.clearFilters",
          "when": "view == folium.tags",
          "group": "navigation@1"
        },
        {
          "command": "folium.refresh",
          "when": "view == folium.tags",
          "group": "navigation@2"
        },
        {
          "command": "folium.tasksGroupBy",
          "when": "view == folium.tasks",
          "group": "navigation@1"
        },
        {
          "command": "folium.toggleDoneTasks",
          "when": "view == folium.tasks",
          "group": "navigation@2"
        },
        {
          "command": "folium.refresh",
          "when": "view == folium.tasks",
          "group": "navigation@3"
        },
        {
          "command": "folium.refresh",
          "when": "view == folium.related",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "folium.setColor",
          "when": "viewItem =~ /^folium\\.note/",
          "group": "inline@1"
        },
        {
          "command": "folium.togglePin",
          "when": "viewItem =~ /^folium\\.note/",
          "group": "inline@2"
        },
        {
          "command": "folium.sendPrompt",
          "when": "viewItem =~ /^folium\\.note/",
          "group": "inline@3"
        },
        {
          "command": "folium.trashNote",
          "when": "viewItem =~ /^folium\\.note/",
          "group": "inline@4"
        },
        {
          "command": "folium.renameNote",
          "when": "viewItem =~ /^folium\\.note/",
          "group": "1_note@1"
        },
        {
          "command": "folium.duplicateNote",
          "when": "viewItem =~ /^folium\\.note/",
          "group": "1_note@2"
        },
        {
          "command": "folium.moveNote",
          "when": "viewItem =~ /^folium\\.note/",
          "group": "1_note@3"
        },
        {
          "command": "folium.archive",
          "when": "viewItem =~ /^folium\\.note(?!\\.archived)/",
          "group": "1_note@4"
        },
        {
          "command": "folium.unarchive",
          "when": "viewItem == folium.note.archived || viewItem =~ /^folium\\.note\\.archived/",
          "group": "1_note@5"
        },
        {
          "command": "folium.updateCodeLinks",
          "when": "viewItem =~ /^folium\\.note/",
          "group": "2_code@1"
        },
        {
          "command": "folium.saveAsTemplate",
          "when": "viewItem =~ /^folium\\.note/",
          "group": "3_templates@1"
        },
        {
          "command": "folium.encryptNote",
          "when": "viewItem =~ /^folium\\.note/",
          "group": "4_security@1"
        },
        {
          "command": "folium.decryptNote",
          "when": "viewItem == folium.note.encrypted",
          "group": "4_security@2"
        },
        {
          "command": "folium.createIssue",
          "when": "viewItem =~ /^folium\\.note/",
          "group": "5_issues@1"
        },
        {
          "command": "folium.restoreTrash",
          "when": "viewItem == folium.trashEntry",
          "group": "inline@1"
        },
        {
          "command": "folium.deleteTrashEntry",
          "when": "viewItem == folium.trashEntry",
          "group": "inline@2"
        },
        {
          "command": "folium.renameTag",
          "when": "viewItem == folium.tag",
          "group": "inline@1"
        },
        {
          "command": "folium.removeTag",
          "when": "viewItem == folium.tag",
          "group": "inline@2"
        },
        {
          "command": "folium.clearFilters",
          "when": "viewItem == folium.filters",
          "group": "inline@1"
        }
      ],
      "editor/context": [
        {
          "command": "folium.newFromSelection",
          "when": "editorHasSelection && !folium.isNote",
          "group": "folium@1"
        },
        {
          "command": "folium.linkSelection",
          "when": "editorHasSelection && !folium.isNote",
          "group": "folium@2"
        },
        {
          "command": "folium.showNotesForFile",
          "when": "!folium.isNote",
          "group": "folium@3"
        },
        {
          "command": "folium.sendLineToTerminal",
          "when": "folium.isNote",
          "group": "folium@0"
        },
        {
          "command": "folium.toggleTask",
          "when": "folium.isNote",
          "group": "folium@1"
        },
        {
          "command": "folium.sendPrompt",
          "when": "folium.promptNote",
          "group": "folium@2"
        }
      ],
      "editor/title": [
        {
          "command": "folium.sendPrompt",
          "when": "folium.promptNote",
          "group": "navigation@1"
        },
        {
          "command": "folium.sendAnswers",
          "when": "folium.followUpNote",
          "group": "navigation@1"
        },
        {
          "command": "folium.sendLineToTerminal",
          "when": "folium.isNote",
          "group": "navigation@0"
        },
        {
          "command": "folium.saveAsTemplate",
          "when": "folium.isNote",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "folium.newNoteWithTitle",
          "when": "false"
        },
        {
          "command": "folium.openNote",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "folium.newNote",
        "key": "alt+n n",
        "mac": "cmd+alt+n n"
      },
      {
        "command": "folium.newFromTemplate",
        "key": "alt+n t",
        "mac": "cmd+alt+n t"
      },
      {
        "command": "folium.search",
        "key": "alt+n s",
        "mac": "cmd+alt+n s"
      },
      {
        "command": "folium.newFromSelection",
        "key": "alt+n c",
        "mac": "cmd+alt+n c",
        "when": "editorHasSelection && !folium.isNote"
      },
      {
        "command": "folium.linkSelection",
        "key": "alt+n l",
        "mac": "cmd+alt+n l",
        "when": "editorHasSelection && !folium.isNote"
      },
      {
        "command": "folium.branchNote",
        "key": "alt+n b",
        "mac": "cmd+alt+n b"
      },
      {
        "command": "folium.sendPrompt",
        "key": "alt+n p",
        "mac": "cmd+alt+n p"
      },
      {
        "command": "folium.captureFollowUp",
        "key": "alt+n f",
        "mac": "cmd+alt+n f"
      },
      {
        "command": "folium.toggleTask",
        "key": "alt+n x",
        "mac": "cmd+alt+n x",
        "when": "folium.isNote"
      },
      {
        "command": "folium.sendLineToTerminal",
        "key": "alt+n enter",
        "mac": "cmd+alt+n enter",
        "when": "folium.isNote"
      }
    ],
    "configuration": {
      "title": "Folium Notes",
      "properties": {
        "foliumNotes.sharedFolder": {
          "type": "string",
          "default": ".notes",
          "scope": "resource",
          "order": 1,
          "markdownDescription": "Folder inside the project for **shared notes** (committed with the code). Default: `.notes`."
        },
        "foliumNotes.privateRoot": {
          "type": "string",
          "default": "~/FoliumNotes",
          "scope": "machine-overridable",
          "order": 2,
          "markdownDescription": "Folder for **private notes**, outside the repository. One folder per project (from the git remote) is created inside it."
        },
        "foliumNotes.privateProjectKey": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "order": 3,
          "markdownDescription": "Override the project key used for the private folder name. Empty = derive from the git remote."
        },
        "foliumNotes.defaultScope": {
          "type": "string",
          "enum": [
            "ask",
            "shared",
            "private"
          ],
          "default": "ask",
          "scope": "window",
          "order": 4,
          "markdownDescription": "Scope used by **New Note** (and whether it asks)."
        },
        "foliumNotes.fileNamePattern": {
          "type": "string",
          "default": "{date}-{slug}",
          "scope": "resource",
          "order": 5,
