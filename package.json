        "icon": "$(tag)"
      },
      {
        "command": "folium.trashNote",
        "title": "Folium: Move Note to Trash",
        "icon": "$(trash)"
      },
      {
        "command": "folium.restoreTrash",
        "title": "Folium: Restore Note from Trash",
        "icon": "$(discard)"
      },
      {
        "command": "folium.deleteTrashEntry",
        "title": "Folium: Delete Note Permanently"
      },
      {
        "command": "folium.emptyTrash",
        "title": "Folium: Empty Trash",
        "icon": "$(clear-all)"
      },
      {
        "command": "folium.newFromSelection",
        "title": "Folium: New Note from Selection",
        "icon": "$(add)"
      },
      {
        "command": "folium.linkSelection",
        "title": "Folium: Link Selection to Note",
        "icon": "$(link)"
      },
      {
        "command": "folium.updateCodeLinks",
        "title": "Folium: Update Code Links"
      },
      {
        "command": "folium.showNotesForFile",
        "title": "Folium: Show Notes for File"
      },
      {
        "command": "folium.createMissingNote",
        "title": "Folium: Create Missing Linked Note"
      },
      {
        "command": "folium.toggleTask",
        "title": "Folium: Toggle Task at Cursor"
      },
      {
        "command": "folium.openTask",
        "title": "Folium: Open Task"
      },
      {
        "command": "folium.showTasks",
        "title": "Folium: Show Tasks",
        "icon": "$(checklist)"
      },
      {
        "command": "folium.sendLineToTerminal",
        "title": "Folium: Send Line to Terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "folium.toggleDoneTasks",
        "title": "Folium: Show/Hide Done Tasks",
        "icon": "$(check-all)"
      },
      {
        "command": "folium.tasksGroupBy",
        "title": "Folium: Group Tasks By…",
        "icon": "$(list-unordered)"
      },
      {
        "command": "folium.toggleTagFilter",
        "title": "Folium: Toggle Tag Filter"
      },
      {
        "command": "folium.filterByTag",
        "title": "Folium: Filter by Tag",
        "icon": "$(tag)"
      },
      {
        "command": "folium.filterByColor",
        "title": "Folium: Filter by Color",
        "icon": "$(symbol-color)"
      },
      {
        "command": "folium.filterByDate",
        "title": "Folium: Filter by Date",
        "icon": "$(calendar)"
      },
      {
        "command": "folium.filterByScope",
        "title": "Folium: Filter by Scope"
      },
      {
        "command": "folium.filterByText",
        "title": "Folium: Filter by Text"
      },
      {
        "command": "folium.setTagFilterMode",
        "title": "Folium: Tag Filter Mode (Any/All)"
      },
      {
        "command": "folium.clearFilters",
        "title": "Folium: Clear Filters",
